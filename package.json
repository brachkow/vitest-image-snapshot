{
  "name": "@brachkow/vitest-image-snapshot",
  "version": "0.1.0",
  "description": "Fast drop-in replacement for jest-image-snapshot, for Vitest and Jest",
  "license": "Apache-2.0",
  "author": "brachkow",
  "repository": {
    "type": "git",
    "url": "https://github.com/brachkow/vitest-image-snapshot.git"
  },
  "keywords": [
    "vitest",
    "jest",
    "image",
    "snapshot",
    "visual regression",
    "screenshot",
    "jest-image-snapshot"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./outdated-snapshot-reporter": {
      "import": {
        "types": "./dist/outdated-snapshot-reporter.d.mts",
        "default": "./dist/outdated-snapshot-reporter.mjs"
      },
      "require": {
        "types": "./dist/outdated-snapshot-reporter.d.cts",
        "default": "./dist/outdated-snapshot-reporter.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "tsdown",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:original",
    "build": "tsdown",
    "test": "vitest run",
    "test:original": "tsdown && cd test/original && jest --config jest.config.cjs --ci=false",
    "typecheck": "tsc --noEmit",
    "bench": "tsdown && node bench/run.ts",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "jest": ">=29",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "es-toolkit": "^1.52.0",
    "glur": "^2.0.0",
    "pixelmatch": "^5.3.0",
    "sharp": "^0.35.5",
    "ssim.js": "^3.5.0",
    "synckit": "^0.12.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-fans": "^1.11.0",
    "globals": "^17.13.0",
    "image-size": "^0.8.3",
    "jest": "^30.5.2",
    "jest-image-snapshot": "6.5.2",
    "jest-snapshot": "^30.5.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^5.0.10",
    "tsdown": "^0.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  }
}
