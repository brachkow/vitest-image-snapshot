{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "test",
    "bench",
    "tsdown.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "test/types/vitest-3.ts",
    "test/runners/jest-*",
    "test/runners/vitest-*"
  ]
}
